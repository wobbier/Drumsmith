/* The song library (TrackList.rml) and the DLC catalogue (DLC.rml): header, scrolling list,
   details column, footer and the sort/filter flyout. */
body.library-page { background-color: #121212; font-family: Inter; }
.library-backdrop { position: absolute; width: 100%; height: 100%; decorator: image(img/track-bg.png cover); image-color: #ffffff38; }
.library-header, .library-footer { position: absolute; left: 0; right: 0; display: flex; align-items: center; background-color: #00000070; }
.library-header { top: 0; height: 56dp; padding: 0 16dp; }
.library-footer { bottom: 0; height: 52dp; padding: 0 24dp; justify-content: space-between; }
.library-header .library-heading { flex: 1; font-size: 16dp; letter-spacing: 2dp; color: #ffffffaa; text-align: center; }
.library-page button { width: auto; margin: 0; border-radius: 0; background-color: transparent; color: #ffffffdc; text-align: left; }
.library-page button:hover, .library-page button:focus { color: #fff; background-color: #ffffff12; }
.library-page .library-link { display: inline-block; padding: 6dp 10dp; font-size: 17dp; white-space: nowrap; }
.library-link img { width: 38dp; height: 38dp; margin-right: 8dp; vertical-align: middle; }
.library-link span { vertical-align: middle; }
.library-list { position: absolute; top: 56dp; bottom: 52dp; left: 0; right: 31vw; padding: 20dp; overflow-y: auto; }
.library-list.full { right: 0; }
.library-status { margin: 0 0 16dp; font-size: 17dp; color: #ffffffb8; }
.track-category { color: white; font-size: 38dp; margin: 14dp 0 16dp; }
.song-row { display: flex; position: relative; min-height: 150dp; margin-bottom: 12dp; background-color: #00000012; border-left: 3dp #ffffff00; }
.song-row:hover, .song-row.selected { background-color: #ffffff12; border-left-color: #ffffff80; }
.song-row.installed { border-left-color: #66ff6680; }
.library-page .art-button { padding: 0; width: 150dp; height: 150dp; flex-shrink: 0; }
.song-art { width: 150dp; height: 150dp; }
.library-page .song-description { flex: 1; min-width: 0; padding: 12dp 16dp 30dp; display: block; }
.library-page .song-description.has-actions { padding-right: 240dp; }
.song-title, .song-artist, .song-year { display: block; }
.song-title { font-size: 30dp; font-weight: bold; line-height: 1.15; }
.song-artist { font-size: 23dp; margin-top: 7dp; }
.song-year { font-size: 16dp; margin-top: 9dp; color: #ffffffaa; }
.song-notes { position: absolute; right: 14dp; bottom: 10dp; font-size: 14dp; color: #ffffffaa; pointer-events: none; }
.song-actions { position: absolute; right: 14dp; top: 12dp; }
.library-page .song-action { display: inline-block; padding: 6dp 10dp; margin-left: 6dp; font-size: 14dp; letter-spacing: 1dp; background-color: #ffffff14; }
.library-page .song-action.download { color: #e363c3; }
.library-page .song-action.play { color: #77cc77; }
.library-page .song-action.tools { color: #ff9933; }
.library-details { position: absolute; top: 56dp; bottom: 52dp; right: 0; width: 31vw; padding: 8dp 16dp 16dp 8dp; box-sizing: border-box; overflow-y: auto; background-color: #00000030; }
.detail-art { width: 100%; height: 28vw; }
.detail-copy { padding: 14dp 10dp; }
.library-details h1 { font-size: 30dp; line-height: 1.15; color: #fff; margin: 0 0 10dp; }
.library-details h2 { font-size: 23dp; margin: 0 0 16dp; }
.library-details p { font-size: 17dp; color: #ffffffb8; margin: 0 0 8dp; }
.library-details .detail-notes { margin: 20dp 0; }
.library-details .detail-state { color: #ff9933; }
.library-page .detail-action { display: block; font-size: 23dp; padding: 8dp 0; margin: 4dp 0; }
.library-page .detail-action.green { color: #77cc77; }
.library-page .detail-action.pink { color: #e363c3; }
.filter-scrim { position: absolute; width: 100%; height: 100%; background-color: #00000080; z-index: 10; }
.library-flyout { position: absolute; right: 0; top: 0; bottom: 0; width: 360dp; padding: 28dp; overflow-y: auto; background-color: #101010; z-index: 11; }
.library-flyout h1 { color: #fff; font-size: 36dp; margin: 24dp 0 12dp; }
.library-flyout button { display: block; width: 100%; font-size: 24dp; padding: 10dp 12dp; }
.library-flyout button.active { color: #e363c3; background-color: #ffffff12; }
.empty-library { font-size: 22dp; padding: 25dp; }
@media (max-width: 1000dp) {
    .song-title { font-size: 23dp; }
    .song-artist { font-size: 18dp; }
    .song-row { min-height: 112dp; }
    .library-page .art-button, .song-art { width: 112dp; height: 112dp; }
    .library-list { padding: 12dp; right: 34vw; }
    .library-list.full { right: 0; }
    .library-details { width: 34vw; }
    .detail-art { height: 30vw; }
    .library-details h1 { font-size: 24dp; }
    .library-details h2 { font-size: 20dp; }
    .library-page .library-link { font-size: 14dp; }
    .library-page .song-action { font-size: 12dp; padding: 4dp 6dp; }
    .library-page .song-description.has-actions { padding-right: 170dp; }
}
