/* The song library (TrackList.rml) and the DLC catalogue (DLC.rml): header, scrolling list,
   details column, footer and the sort/filter flyout. */
body.library-page { background-color: #121212; font-family: Inter; }
.library-backdrop { position: absolute; width: 100%; height: 100%; decorator: image(img/track-bg.png cover); image-color: #ffffff38; }
.library-header, .library-footer { position: absolute; left: 0; right: 0; display: flex; align-items: center; background-color: #00000070; }
.library-header { top: 0; height: 56dp; padding: 0 16dp; }
.library-footer { bottom: 0; height: 52dp; padding: 0 24dp; justify-content: space-between; }
.library-header .library-heading { flex: 1; font-size: 16dp; letter-spacing: 2dp; color: #ffffffaa; text-align: center; }
.library-page button { width: auto; margin: 0; border-radius: 0; background-color: transparent; color: #ffffffdc; text-align: left; }
.library-page button:hover, .library-page button:focus { color: #fff; background-color: #ffffff12; }
.library-page .library-link { display: inline-block; padding: 6dp 10dp; font-size: 17dp; white-space: nowrap; }
.library-link img { width: 38dp; height: 38dp; margin-right: 8dp; vertical-align: middle; }
.library-link span { vertical-align: middle; }
.library-list { position: absolute; top: 56dp; bottom: 52dp; left: 0; right: 31vw; padding: 20dp; overflow-y: auto; }
.library-list.full { right: 0; }
.library-list.with-search { top: 116dp; }
.library-search { position: absolute; top: 56dp; left: 0; right: 31vw; height: 60dp; padding: 10dp 20dp 0; display: flex; align-items: center; gap: 10dp; }
.library-search input.text { flex: 1; min-width: 0; padding: 8dp 12dp; font-size: 19dp; background-color: #000000a0; }
.library-search input.text:placeholder-shown { color: #ffffff70; }
.library-page .library-search .library-link.active { color: #ffcc33; background-color: #ffffff12; }
.library-page .favorite-toggle { position: absolute; right: 8dp; top: 6dp; padding: 2dp 10dp; font-size: 30dp; color: #ffffff70; }
.library-page .favorite-toggle.on { color: #ffcc33; }
.library-status { margin: 0 0 16dp; font-size: 17dp; color: #ffffffb8; }
.track-category { color: white; font-size: 38dp; margin: 14dp 0 16dp; }
.song-row { display: flex; position: relative; min-height: 150dp; margin-bottom: 12dp; background-color: #00000012; border-left: 3dp #ffffff00; }
.song-row:hover, .song-row.selected { background-color: #ffffff12; border-left-color: #ffffff80; }
.song-row.installed { border-left-color: #66ff6680; }
.library-page .art-button { padding: 0; width: 150dp; height: 150dp; flex-shrink: 0; }
.song-art { width: 150dp; height: 150dp; }
.library-page .song-description { flex: 1; min-width: 0; padding: 12dp 16dp 30dp; display: block; }
.library-page .song-description.has-actions { padding-right: 240dp; }
.song-title, .song-artist, .song-year { display: block; }
.song-title { font-size: 30dp; font-weight: bold; line-height: 1.15; }
.song-artist { font-size: 23dp; margin-top: 7dp; }
.song-year { font-size: 16dp; margin-top: 9dp; color: #ffffffaa; }
.song-notes { position: absolute; right: 14dp; bottom: 10dp; font-size: 14dp; color: #ffffffaa; pointer-events: none; }
.song-actions { position: absolute; right: 14dp; top: 12dp; }
.library-page .song-action { display: inline-block; padding: 6dp 10dp; margin-left: 6dp; font-size: 14dp; letter-spacing: 1dp; background-color: #ffffff14; }
.library-details .listen-caption { margin: 14dp 0 4dp; font-size: 14dp; color: #ffffff90; }
.listen-links { display: block; margin-bottom: 6dp; }
.library-page .listen-link { display: inline-block; width: auto; margin: 0 6dp 4dp 0; padding: 5dp 10dp; font-size: 15dp; color: #9fd8ff; background-color: #ffffff14; }
.song-badges { display: block; margin-top: 6dp; }
.badge { display: inline-block; margin-right: 6dp; padding: 2dp 7dp; font-size: 12dp; letter-spacing: 1dp; color: #101010; background-color: #c5c5c5; border-radius: 3dp; }
.badge.ds-ready { background-color: #ff9933; }
.library-page .detail-action.red { color: #e36363; }
.library-page .song-action.download { color: #e363c3; }
.library-page .song-action.play { color: #77cc77; }
.library-page .song-action.tools { color: #ff9933; }
.library-details { position: absolute; top: 56dp; bottom: 52dp; right: 0; width: 31vw; padding: 8dp 16dp 16dp 8dp; box-sizing: border-box; overflow-y: auto; background-color: #00000030; }
.detail-art { width: 100%; height: 28vw; }
.detail-copy { padding: 14dp 10dp; }
.library-details h1 { font-size: 30dp; line-height: 1.15; color: #fff; margin: 0 0 10dp; }
.library-details h2 { font-size: 23dp; margin: 0 0 16dp; }
.library-details p { font-size: 17dp; color: #ffffffb8; margin: 0 0 8dp; }
.library-details .detail-notes { margin: 20dp 0; }
.library-details .detail-state { color: #ff9933; }
.library-details .detail-advice p { color: #ffb347; font-size: 15dp; margin: 0 0 6dp; }
.library-page .detail-action { display: block; font-size: 23dp; padding: 8dp 0; margin: 4dp 0; }
.library-page .detail-action.green { color: #77cc77; }
.library-page .detail-action.pink { color: #e363c3; }
.filter-scrim { position: absolute; width: 100%; height: 100%; background-color: #00000080; z-index: 10; }
.library-flyout { position: absolute; right: 0; top: 0; bottom: 0; width: 360dp; padding: 28dp; overflow-y: auto; background-color: #101010; z-index: 11; }
.library-flyout h1 { color: #fff; font-size: 36dp; margin: 24dp 0 12dp; }
.library-flyout button { display: block; width: 100%; font-size: 24dp; padding: 10dp 12dp; }
.library-flyout button.active { color: #e363c3; background-color: #ffffff12; }
.empty-library { font-size: 22dp; padding: 25dp; }
/* The song library's own look (TrackList.rml): compact rows that play on a click anywhere, and a
   details column with one obvious PLAY button. The DLC catalogue keeps the rules above. */
.song-library .library-list { padding: 8dp 16dp 16dp 20dp; }
.song-library .track-category { margin: 18dp 0 8dp; padding-bottom: 6dp; font-size: 15dp; font-weight: bold; letter-spacing: 3dp; color: #ff9933; border-bottom: 1dp #ffffff22; }
.song-library .song-row { display: block; min-height: 0; height: 76dp; margin-bottom: 4dp; background-color: #00000050; border-left: 3dp #ffffff00; border-radius: 4dp; }
.song-library .song-row:hover, .song-library .song-row.selected { background-color: #ffffff1c; border-left-color: #ff9933; }
.song-library .row-play { display: flex; align-items: center; width: 100%; height: 76dp; padding: 0 64dp 0 0; border-bottom-width: 0; box-sizing: border-box; }
.song-library .row-play:hover, .song-library .row-play:focus { background-color: transparent; }
.song-library .song-art { width: 76dp; height: 76dp; flex-shrink: 0; border-radius: 4dp 0 0 4dp; }
.song-library .row-text { display: block; flex: 1; min-width: 0; padding: 0 16dp; }
.song-library .song-title, .song-library .song-artist { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.song-library .song-title { font-size: 21dp; font-weight: bold; line-height: 1.2; color: #fff; }
.song-library .song-artist { font-size: 16dp; margin-top: 4dp; color: #ffffffa0; }
.song-library .row-meta { display: block; flex-shrink: 0; text-align: right; white-space: nowrap; }
.song-library .row-meta .song-year, .song-library .row-meta .song-notes { display: inline-block; position: static; margin: 0 0 0 14dp; font-size: 14dp; color: #ffffff80; }
.song-library .row-meta .badge { vertical-align: middle; }
.song-library .row-go { display: inline-block; visibility: hidden; flex-shrink: 0; margin-left: 16dp; padding: 6dp 14dp; font-size: 14dp; font-weight: bold; letter-spacing: 2dp; color: #101010; background-color: #77cc77; border-radius: 4dp; }
.song-library .song-row.selected .row-go { visibility: visible; }
.song-library .favorite-toggle { right: 12dp; top: 18dp; padding: 2dp 8dp; font-size: 24dp; border-bottom-width: 0; }
.song-library .library-details { padding: 16dp 20dp; background-color: #00000060; border-left: 1dp #ffffff18; }
.song-library .detail-art { display: block; width: 20vw; height: 20vw; margin: 0 auto; border-radius: 6dp; }
.song-library .detail-copy { padding: 16dp 0 0; }
.song-library .library-details h1 { font-size: 28dp; margin: 0 0 4dp; }
.song-library .library-details h2 { font-size: 20dp; font-weight: normal; margin: 0 0 12dp; color: #ffffffd0; }
.song-library .library-details .detail-meta { font-size: 15dp; margin: 0 0 4dp; color: #ffffff90; }
.song-library .detail-badges { margin: 8dp 0 0; }
.song-library .detail-play { display: block; width: 100%; box-sizing: border-box; margin: 16dp 0 10dp; padding: 12dp 0; font-size: 22dp; font-weight: bold; letter-spacing: 4dp; text-align: center; color: #101010; background-color: #77cc77; border-radius: 6dp; border-bottom-width: 0; }
.song-library .detail-play:hover, .song-library .detail-play:focus { color: #000; background-color: #99ee99; }
.song-library .detail-chips { display: block; margin-bottom: 12dp; }
.song-library .chip { display: inline-block; margin: 0 6dp 6dp 0; padding: 7dp 12dp; font-size: 15dp; background-color: #ffffff16; border-radius: 4dp; border-bottom-width: 0; }
.song-library .chip:hover, .song-library .chip:focus { background-color: #ffffff30; }
.song-library .chip.on { color: #ffcc33; }
.song-library .listen-link { border-radius: 4dp; border-bottom-width: 0; }
.song-library .detail-remove { display: block; margin-top: 14dp; padding: 6dp 0; font-size: 14dp; color: #e36363a0; border-bottom-width: 0; }
.song-library .detail-remove:hover, .song-library .detail-remove:focus { color: #ff7b7b; background-color: transparent; }
@media (max-width: 1000dp) {
    .song-title { font-size: 23dp; }
    .song-artist { font-size: 18dp; }
    .song-row { min-height: 112dp; }
    .library-page .art-button, .song-art { width: 112dp; height: 112dp; }
    .library-list { padding: 12dp; right: 34vw; }
    .library-search { right: 34vw; padding: 10dp 12dp 0; }
    .library-list.full { right: 0; }
    .library-details { width: 34vw; }
    .detail-art { height: 30vw; }
    .library-details h1 { font-size: 24dp; }
    .library-details h2 { font-size: 20dp; }
    .library-page .library-link { font-size: 14dp; }
    .library-page .song-action { font-size: 12dp; padding: 4dp 6dp; }
    .library-page .song-description.has-actions { padding-right: 170dp; }
}
/* The player's record of the song (PlayerProfile). */
.library-details .detail-best { margin: 6dp 0; font-size: 16dp; color: #ffd166; }
