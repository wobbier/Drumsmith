<rml>
<head>
    <title>Drumsmith — Download Songs</title>
    <link type="text/rcss" href="Drumsmith.rcss"/>
    <link type="text/rcss" href="Library.rcss"/>
    <link type="text/rcss" href="Radio.rcss"/>
</head>
<body class="library-page" data-model="dlc_store">
    <div class="library-backdrop"></div>
    <div class="library-header">
        <button id="dlc-back" class="library-link" onclick="load-scene:Assets/MainMenu.lvl"><img src="img/Esc_Key_Light.png"/><span>Main Menu</span></button>
        <button id="dlc-toggle-details" class="library-link" data-event-click="toggle_details"><span>{{details_open ? 'Hide details' : 'Show details'}}</span></button>
        <span class="library-heading">DOWNLOAD SONGS</span>
        <button id="dlc-refresh" class="library-link" data-event-click="refresh"><span>Refresh</span></button>
        <button id="dlc-library" class="library-link" onclick="load-scene:Assets/TrackList.lvl"><span>Installed songs</span></button>
    </div>
    <div id="song-list" class="library-list" data-class-full="!details_open">
        <p class="library-status" data-if="status != ''">{{status}}</p>
        <p class="empty-library" data-if="track_count == 0 && !loading">Nothing to show. Pick another filter, or set a DLC server under Settings.</p>
        <div data-for="track : tracks">
            <h2 class="track-category" data-if="track.category != ''">{{track.category}}</h2>
            <div class="song-row" data-class-selected="selected == track.index" data-class-installed="track.installed" data-event-mouseover="select(track.index)">
                <button class="art-button" data-event-click="select(track.index)" data-event-focus="select(track.index)"><img class="song-art" data-attr-src="track.art"/></button>
                <button class="song-description has-actions" data-event-click="select(track.index)" data-event-focus="select(track.index)">
                    <span class="song-title">{{track.title}}</span>
                    <span class="song-artist">{{track.artist}}</span>
                    <span class="song-year">{{track.year}}</span>
                </button>
                <div class="song-actions">
                    <button class="song-action download" data-if="!track.installed && !track.busy" data-event-click="download(track.index)">DOWNLOAD TRACK</button>
                    <button class="song-action play" data-if="track.installed" data-event-click="play(track.index)">PLAY</button>
                    <button class="song-action tools" data-if="track.installed && tools" data-event-click="edit(track.index)">EDIT CHART</button>
                </div>
                <span class="song-notes">{{track.state}}</span>
            </div>
        </div>
    </div>
    <div class="library-details" data-if="selected >= 0 && details_open">
        <img class="detail-art" data-attr-src="detail_art"/>
        <div class="detail-copy">
            <h1>{{detail_title}}</h1>
            <h2>{{detail_artist}}</h2>
            <p>{{detail_album}}</p>
            <p>{{detail_source}}</p>
            <p>{{detail_year}}</p>
            <p class="detail-notes" data-if="detail_installed">Note Count: {{detail_notes}}</p>
            <p class="detail-notes" data-if="!detail_installed">{{detail_files}} files to download</p>
            <p class="detail-state" data-if="detail_state != ''">{{detail_state}}</p>
            <button id="download-selected" class="detail-action pink" data-if="!detail_installed && !detail_busy" data-event-click="download(selected)">Download</button>
            <button id="play-selected" class="detail-action green" data-if="detail_installed" data-event-click="play(selected)">PLAY</button>
            <button class="detail-action" data-if="detail_installed" data-event-click="preview(selected)">Preview</button>
            <button class="detail-action" data-if="detail_installed && tools" data-event-click="edit(selected)">Edit chart</button>
        </div>
    </div>
    <div class="library-footer">
        <button id="dlc-filters" class="library-link" data-event-click="toggle_filters"><span>Sorting: {{sort_name}} (Ascending) / Filter: {{filter_name}}</span></button>
        <span>{{track_count}} songs</span>
    </div>
    <div class="filter-scrim" data-if="filters_open" data-event-click="toggle_filters"></div>
    <div class="library-flyout" data-if="filters_open">
        <button class="detail-action" data-event-click="toggle_filters">&lt; Back</button>
        <h1>Sort</h1>
        <button id="sort-default" data-class-active="sort == 0" data-event-click="sort(0)">Default</button>
        <button id="sort-title" data-class-active="sort == 1" data-event-click="sort(1)">Title</button>
        <button id="sort-artist" data-class-active="sort == 2" data-event-click="sort(2)">Artist</button>
        <button id="sort-year" data-class-active="sort == 3" data-event-click="sort(3)">Year</button>
        <h1>Filter</h1>
        <button data-for="option : filters" data-class-active="filter == option.index" data-event-click="filter(option.index)">{{option.name}} ({{option.count}})</button>
    </div>
    <div id="track-radio-hover" data-event-mouseover="radio_show"></div>
    <div id="track-radio" data-if="radio_available" data-class-visible="radio_visible" data-event-mouseover="radio_show">
        <img class="radio-art" data-attr-src="radio_art"/>
        <div class="radio-details">
            <div class="radio-caption">NOW PLAYING</div>
            <div id="radio-title">{{radio_title}}</div>
            <div id="radio-artist">{{radio_artist}}</div>
            <div class="radio-controls">
                <div class="radio-progress">
                    <input id="radio-seek" type="range" min="0" max="1000" step="1" data-attr-value="radio_progress" data-event-change="seek(ev.value)"/>
                    <div class="radio-times"><span>{{radio_position}}</span><span>{{radio_duration}}</span></div>
                </div>
                <button id="radio-skip" data-event-click="skip">Skip</button>
            </div>
        </div>
    </div>
</body>
</rml>
