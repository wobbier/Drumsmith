#pause-hint { position: absolute; top: 12dp; right: 18dp; font-size: 16dp; color: #ffffffb0; }
#pause-overlay { position: absolute; width: 100%; height: 100%; background-color: #000000b3; }
#pause-menu, #pause-options { position: absolute; top: 10%; left: 50%; width: 602dp; max-width: 88vw; transform: translateX(-50%); max-height: 85vh; overflow-y: auto; text-align: center; }
.pause-logo { display: block; width: 100%; height: auto; }
.pause-underline { display: block; width: 100%; height: 10dp; margin: 12dp 0 28dp; }
#pause-options h2 { margin-top: 22dp; }
#pause-options label { display: block; margin: 28dp 0 12dp; font-size: 26dp; }
#pause-options input.range { display: block; width: 80%; margin: 0 auto; }
#pause-options p { margin-top: 15dp; font-size: 17dp; }
@media (max-height: 650px) {
    #pause-menu .menu-link, #pause-options .menu-link { font-size: 34dp; margin-top: 12dp; }
    .pause-logo { width: 75%; margin: 0 auto; }
    .pause-underline { margin-bottom: 12dp; }
}
/* Gameplay HUD (NoteHighwayCore fills it): score column, judgement, lead-in, results. */
#hud { position: absolute; top: 40dp; left: 24dp; width: 260dp; }
#hud-score { font-size: 44dp; font-weight: bold; }
#hud-multiplier { font-size: 30dp; color: #ffffffa0; }
#hud-multiplier.hot { color: #ff9933; }
#hud-combo { font-size: 22dp; color: #66ff66; margin-top: 6dp; }
#hud-accuracy { font-size: 18dp; color: #ffffffb0; margin-top: 6dp; }
#hud-lyrics { position: absolute; top: 24dp; left: 50%; width: 1000dp; max-width: 64vw; transform: translateX(-50%); text-align: center; }
#hud-lyrics .lyric-line { font-size: 32dp; white-space: pre; font-effect: outline( 2dp #000000d0 ); }
#hud-lyrics .lyric-sung { color: #ffc840; }
#hud-lyrics .lyric-rest { color: #ffffff; }
/* A story moment's caption. Upright: only Inter Regular is loaded, and an italic face that isn't there draws nothing. */
#hud-caption { position: absolute; top: 120dp; left: 50%; width: 900dp; max-width: 60vw; transform: translateX(-50%); text-align: center; font-size: 30dp; color: #ffe2c8; font-effect: outline( 2dp #000000e0 ); }
#hud-lyrics .lyric-next { font-size: 22dp; margin-top: 4dp; white-space: pre; color: #ffffff80; font-effect: outline( 2dp #000000b0 ); }
#hud-autoplay { font-size: 16dp; color: #ff9933; margin-top: 6dp; }
#hud-judgement { position: absolute; top: 30%; left: 0; width: 100%; text-align: center; }
#judgement-text { font-size: 52dp; font-weight: bold; color: #ffffff; font-effect: outline( 2dp #000000c0 ); }
#judgement-text.perfect { color: #66ffff; }
#judgement-text.miss { color: #ff3333; }
#judgement-timing { font-size: 20dp; color: #ffffffc0; font-effect: outline( 1dp #000000c0 ); }
#judgement-hint { font-size: 26dp; font-weight: bold; color: #ff9933; margin-top: 4dp; font-effect: outline( 1dp #000000c0 ); }
#hud-countdown { position: absolute; top: 22%; left: 0; width: 100%; text-align: center; font-effect: outline( 2dp #000000c0 ); }
#countdown-title { font-size: 44dp; font-weight: bold; }
#countdown-artist { font-size: 26dp; color: #ffffffc0; margin-bottom: 16dp; }
#countdown-number { font-size: 96dp; font-weight: bold; color: #ff9933; }
#results { position: absolute; width: 100%; height: 100%; padding-top: 8vh; text-align: center; background-color: #000000c8; }
#results h2 { font-size: 40dp; }
#results .results-artist { font-size: 24dp; color: #ffffffb0; margin: 6dp 0 18dp; }
#results .results-autoplay { font-size: 20dp; color: #ff9933; margin: -10dp 0 14dp; }
#results-score { font-size: 72dp; font-weight: bold; color: #ff9933; margin-bottom: 18dp; }
/* What the profile made of this run (PlayerProfile): a new best or a lesson passed, then the standing bests. */
#results .results-news { font-size: 26dp; font-weight: bold; color: #66ff99; margin: -8dp 0 4dp; }
#results .results-bests { font-size: 18dp; color: #ffffffa0; margin: 0 0 12dp; }
#results .results-gig { font-size: 18dp; letter-spacing: 2dp; color: #ff9933; margin: -8dp 0 10dp; }
#results .results-gig-result { font-size: 22dp; color: #ffffff; margin: -4dp 0 10dp; }
#results .results-unlocks { font-size: 20dp; color: #ffd166; white-space: pre-line; margin: -4dp 0 12dp; }
.results-grid { width: 360dp; margin: 0 auto 10dp; }
.results-row { display: flex; justify-content: space-between; font-size: 22dp; padding: 4dp 0; border-bottom: 1dp #ffffff20; }
#results .menu-link { font-size: 36dp; margin-top: 14dp; }
/* The delay calibration: what to do now, and what it found. */
#hud-calibration { position: absolute; top: 24dp; left: 0; width: 100%; text-align: center; font-effect: outline( 2dp #000000d0 ); }
#calibration-prompt { font-size: 48dp; font-weight: bold; color: #ff9933; }
#calibration-detail { font-size: 24dp; margin-top: 4dp; }
#calibration-progress { font-size: 20dp; color: #ffffffb0; margin-top: 6dp; }
#calibration-results { position: absolute; width: 100%; height: 100%; padding-top: 8vh; text-align: center; background-color: #000000c8; }
#calibration-results h2 { font-size: 40dp; }
#calibration-results .results-artist { font-size: 22dp; color: #ffffffb0; margin: 6dp 0 18dp; }
.calibration-grid { width: 520dp; max-width: 90vw; margin: 0 auto 10dp; }
.calibration-row { display: flex; justify-content: space-between; font-size: 28dp; padding: 6dp 0 2dp; }
.calibration-value { font-weight: bold; color: #ff9933; }
.calibration-note { font-size: 18dp; color: #ffffffb0; text-align: left; padding-bottom: 8dp; margin-bottom: 8dp; border-bottom: 1dp #ffffff20; }
#calibration-results .menu-link { font-size: 36dp; margin-top: 14dp; }
/* Debug panel (F8): no fail and the song scrubber. */
#debug-panel { position: absolute; bottom: 16dp; left: 50%; width: 720dp; max-width: 92vw; transform: translateX(-50%); padding: 10dp 16dp 14dp; background-color: #000000b0; border: 1dp #ffffff30; border-radius: 6dp; }
.debug-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8dp; font-size: 18dp; }
.debug-title { color: #ff9933; font-weight: bold; }
.debug-clock { color: #ffffffc0; }
.debug-toggle { padding: 4dp 12dp; border: 1dp #ffffff50; border-radius: 4dp; color: #ffffffc0; }
.debug-toggle:hover { background-color: #ffffff20; }
.debug-toggle.on { color: #000000; background-color: #66ff66; border-color: #66ff66; }
#debug-seek { display: block; width: 100%; }
/* Options tabs (the engine's tab: action) and the Graphics page (the engine's player-settings actions). */
#pause-tabs { display: flex; justify-content: center; margin: 12dp 0 4dp; border-bottom: 1dp #ffffff30; }
#pause-options .tab { display: block; width: auto; margin: 0 4dp; padding: 9dp 16dp; font-size: 22dp; color: #c5c5c5; border-bottom: 3dp #ffffff00; }
#pause-options .tab:hover, #pause-options .tab:focus { color: #ffffff; }
#pause-options .tab.selected { color: #ffffff; border-bottom-color: #ff9933; }
#pause-options .choice-row { display: flex; flex-wrap: wrap; justify-content: center; }
#pause-options .choice-row .device-choice, #pause-options .choice-row .choice { display: block; width: auto; margin: 4dp; padding: 8dp 14dp; font-size: 18dp; border: 1dp #ffffff30; background-color: #ffffff08; }
#pause-options .choice-row .device-choice:hover, #pause-options .choice-row .choice:hover { border-color: #ffffff80; }
#pause-options .choice-row .device-choice.selected, #pause-options .choice-row .choice.selected { border-color: #66ff66; background-color: #66ff6618; }
