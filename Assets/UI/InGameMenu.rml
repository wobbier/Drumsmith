<rml>
<head>
    <title>Drumsmith</title>
    <link type="text/rcss" href="Drumsmith.rcss"/>
    <link type="text/rcss" href="InGameMenu.rcss"/>
</head>
<body data-model="in_game">
    <div id="pause-hint" data-if="!paused && !finished">{{pause_hint}}</div>
    <div id="hud" data-if="playing && !finished && !calibration">
        <div id="hud-score">{{score}}</div>
        <div id="hud-multiplier" data-class-hot="multiplier > 1">x{{multiplier}}</div>
        <div id="hud-combo" data-if="combo >= 5">{{combo}} combo</div>
        <div id="hud-accuracy">{{accuracy}}</div>
        <div id="hud-autoplay" data-if="debug_autoplay > 0">AUTOPLAY {{debug_autoplay_label}}</div>
    </div>
    <div id="hud-lyrics" data-if="playing && !finished && lyrics_shown">
        <div class="lyric-line"><span class="lyric-sung">{{lyric_sung}}</span><span class="lyric-rest">{{lyric_rest}}</span></div>
        <div class="lyric-next">{{lyric_next}}</div>
    </div>
    <div id="hud-calibration" data-if="playing && !finished && calibration">
        <div id="calibration-prompt">{{cal_prompt}}</div>
        <div id="calibration-detail">{{cal_detail}}</div>
        <div id="calibration-progress">{{cal_progress}}</div>
    </div>
    <div id="hud-judgement" data-if="playing && !finished && judgement != ''" data-style-opacity="judgement_opacity">
        <div id="judgement-text" data-class-miss="judgement == 'MISS'" data-class-perfect="judgement == 'PERFECT'">{{judgement}}</div>
        <div id="judgement-timing">{{timing}}</div>
        <div id="judgement-hint" data-if="hint != ''">{{hint}}</div>
    </div>
    <div id="debug-panel" data-if="debug && playing && !finished">
        <div class="debug-row">
            <span class="debug-title">DEBUG (F8)</span>
            <button class="debug-toggle" data-class-on="debug_nofail" data-event-click="debug_nofail">No fail: {{debug_nofail ? 'ON' : 'OFF'}}</button>
            <button class="debug-toggle" data-class-on="debug_autoplay > 0" data-event-click="debug_autoplay">Autoplay: {{debug_autoplay_label}}</button>
            <button class="debug-toggle" data-class-on="debug_plain" data-event-click="debug_plain">Strokes: {{debug_plain ? 'PLAIN' : 'CHART'}}</button>
            <span class="debug-clock">{{song_clock}}</span>
        </div>
        <input id="debug-seek" type="range" min="0" max="1000" step="1" data-attr-value="song_progress" data-event-change="debug_seek(ev.value)"/>
    </div>
    <div id="hud-countdown" data-if="playing && (countdown > 0 || countdown_intro)">
        <div id="countdown-title">{{track_title}}</div>
        <div id="countdown-artist">{{track_artist}}</div>
        <div id="countdown-number" data-if="countdown > 0">{{countdown}}</div>
    </div>
    <div id="calibration-results" data-if="finished && calibration">
        <h2>Calibration</h2>
        <p class="results-artist">How late your hits landed, which is the delay to make up for</p>
        <div class="calibration-grid">
            <div class="calibration-row"><span class="calibration-name">Visual delay</span><span class="calibration-value">{{cal_video}}</span></div>
            <p class="calibration-note">{{cal_video_note}}</p>
            <div class="calibration-row"><span class="calibration-name">Audio delay</span><span class="calibration-value">{{cal_audio}}</span></div>
            <p class="calibration-note">{{cal_audio_note}}</p>
        </div>
        <div data-if="cal_can_apply"><button id="calibration-apply" class="menu-link green" data-event-click="cal_apply">USE THESE<span class="underline"></span></button></div>
        <div><button id="calibration-retry" class="menu-link orange" data-event-click="retry">TRY AGAIN<span class="underline"></span></button></div>
        <div><button id="calibration-back" class="menu-link red" onclick="load-scene:Assets/MainMenu.lvl">BACK<span class="underline"></span></button></div>
    </div>
    <div id="results" data-if="finished && !calibration">
        <h2>{{track_title}}</h2>
        <p class="results-artist">{{track_artist}}</p>
        <p class="results-autoplay" data-if="debug_autoplay > 0">Autoplayed ({{debug_autoplay_label}})</p>
        <div id="results-score">{{score}}</div>
        <div class="results-grid">
            <div class="results-row"><span>Accuracy</span><span>{{accuracy}}</span></div>
            <div class="results-row"><span>Perfect</span><span>{{hits_perfect}}</span></div>
            <div class="results-row"><span>Great</span><span>{{hits_great}}</span></div>
            <div class="results-row"><span>Good</span><span>{{hits_good}}</span></div>
            <div class="results-row"><span>Missed</span><span>{{hits_missed}}</span></div>
            <div class="results-row"><span>Average timing</span><span>{{avg_timing}}</span></div>
            <div class="results-row"><span>Wrong technique</span><span>{{wrong_technique}}</span></div>
            <div class="results-row"><span>Best combo</span><span>{{max_combo}} / {{total_notes}}</span></div>
        </div>
        <div><button id="results-retry" class="menu-link orange" data-event-click="retry">RETRY<span class="underline"></span></button></div>
        <div data-if="!practice"><button id="results-continue" class="menu-link green" onclick="load-scene:Assets/TrackList.lvl">CONTINUE<span class="underline"></span></button></div>
        <div data-if="practice"><button id="results-lessons" class="menu-link green" onclick="load-scene:Assets/Practice.lvl">LESSONS<span class="underline"></span></button></div>
    </div>
    <div id="pause-overlay" data-if="paused">
        <div id="pause-menu" data-if="!options">
            <img class="pause-logo" src="img/2x/Asset 2@2x.png"/>
            <img class="pause-underline" src="img/Underline.png"/>
            <p id="midi-notice" class="muted" data-if="midi_notice != ''">{{midi_notice}}</p>
            <div><button id="resume" class="menu-link green" data-event-click="resume">RESUME<span class="underline"></span></button></div>
            <div><button id="restart" class="menu-link pink" data-event-click="retry">RESTART<span class="underline"></span></button></div>
            <div><button id="options" class="menu-link orange" data-event-click="options">OPTIONS<span class="underline"></span></button></div>
            <div><button class="menu-link red" data-event-click="exit">EXIT<span class="underline"></span></button></div>
        </div>
        <div id="pause-options" data-if="options">
            <button id="options-back" class="menu-link green" data-event-click="back">Back<span class="underline"></span></button>
            <h2>OPTIONS</h2>
            <div id="pause-tabs">
                <button id="pause-tab-game" class="tab selected" onclick="tab:pause-page-game">Game</button>
                <button id="pause-tab-graphics" class="tab" onclick="tab:pause-page-graphics">Graphics</button>
            </div>
            <div class="tab-page" id="pause-page-game">
                <label for="pause-master-volume">Master Volume ({{master_volume}}%)</label>
                <input id="pause-master-volume" class="range" type="range" min="0" max="100" step="1" data-value="master_volume" data-event-change="master_volume(ev.value)"/>
                <label for="pause-audio-delay">Audio Delay ({{audio_delay}} ms)</label>
                <input id="pause-audio-delay" class="range" type="range" min="0" max="250" step="1" data-value="audio_delay" data-event-change="audio_delay(ev.value)"/>
                <label for="pause-video-delay">Visual Delay ({{video_delay}} ms)</label>
                <input id="pause-video-delay" class="range" type="range" min="0" max="250" step="1" data-value="video_delay" data-event-change="video_delay(ev.value)"/>
                <label>Metronome</label>
                <button id="pause-metronome" class="debug-toggle" data-class-on="metronome" data-event-click="metronome">{{metronome ? 'ON' : 'OFF'}}</button>
                <label for="pause-highway-speed">Highway Speed ({{highway_speed}}%)</label>
                <input id="pause-highway-speed" class="range" type="range" min="50" max="200" step="5" data-value="highway_speed" data-event-change="highway_speed(ev.value)"/>
            </div>
            <div class="tab-page" id="pause-page-graphics" style="display: none;">
                <p class="muted">These apply and save as you change them.</p>
                <label>Quality</label>
                <div class="choice-row">
                    <button id="pause-quality-auto" class="device-choice" onclick="setting:Graphics.Quality|&quot;&quot;" data-setting-selected="Graphics.Quality|&quot;&quot;">Auto</button>
                    <div class="choice-row" data-options="quality"></div>
                </div>
                <label>Display</label>
                <div class="choice-row">
                    <button id="pause-window-windowed" class="device-choice" onclick="window-mode:windowed" data-window-mode="windowed">Windowed</button>
                    <button id="pause-window-borderless" class="device-choice" onclick="window-mode:borderless" data-window-mode="borderless">Borderless</button>
                    <button id="pause-window-fullscreen" class="device-choice" onclick="window-mode:fullscreen" data-window-mode="fullscreen">Fullscreen</button>
                </div>
                <label>VSync</label>
                <div class="choice-row">
                    <button id="pause-vsync-on" class="device-choice" onclick="setting:Graphics.VSync|true" data-setting-selected="Graphics.VSync|true">On</button>
                    <button id="pause-vsync-off" class="device-choice" onclick="setting:Graphics.VSync|false" data-setting-selected="Graphics.VSync|false">Off</button>
                </div>
                <label>Frame Rate Limit</label>
                <div class="choice-row">
                    <button id="pause-max-fps-0" class="device-choice" onclick="setting:Graphics.MaxFrameRate|0" data-setting-selected="Graphics.MaxFrameRate|0">None</button>
                    <button id="pause-max-fps-60" class="device-choice" onclick="setting:Graphics.MaxFrameRate|60" data-setting-selected="Graphics.MaxFrameRate|60">60</button>
                    <button id="pause-max-fps-120" class="device-choice" onclick="setting:Graphics.MaxFrameRate|120" data-setting-selected="Graphics.MaxFrameRate|120">120</button>
                    <button id="pause-max-fps-144" class="device-choice" onclick="setting:Graphics.MaxFrameRate|144" data-setting-selected="Graphics.MaxFrameRate|144">144</button>
                    <button id="pause-max-fps-240" class="device-choice" onclick="setting:Graphics.MaxFrameRate|240" data-setting-selected="Graphics.MaxFrameRate|240">240</button>
                </div>
                <label>Render Scale (<span data-setting-text="Graphics.RenderScale" data-format="percent"></span>)</label>
                <div class="choice-row">
                    <button id="pause-render-scale-down" class="device-choice" onclick="setting-step:Graphics.RenderScale|-0.1">Lower</button>
                    <button id="pause-render-scale-up" class="device-choice" onclick="setting-step:Graphics.RenderScale|0.1">Higher</button>
                </div>
                <label>Upscaling</label>
                <div class="choice-row">
                    <button id="pause-upscale-default" class="device-choice" onclick="setting:Graphics.Upscale|&quot;&quot;" data-setting-selected="Graphics.Upscale|&quot;&quot;">Default</button>
                    <button id="pause-upscale-smooth" class="device-choice" onclick="setting:Graphics.Upscale|Bilinear" data-setting-selected="Graphics.Upscale|Bilinear">Smooth</button>
                    <button id="pause-upscale-sharp" class="device-choice" onclick="setting:Graphics.Upscale|Sharp" data-setting-selected="Graphics.Upscale|Sharp">Sharp</button>
                </div>
                <label>Dynamic Resolution</label>
                <div class="choice-row">
                    <button id="pause-dynamic-resolution-on" class="device-choice" onclick="setting:Graphics.DynamicResolution|true" data-setting-selected="Graphics.DynamicResolution|true">On</button>
                    <button id="pause-dynamic-resolution-off" class="device-choice" onclick="setting:Graphics.DynamicResolution|false" data-setting-selected="Graphics.DynamicResolution|false">Off</button>
                </div>
            </div>
            <button class="menu-link green" data-event-click="save">Save Settings<span class="underline"></span></button>
            <p class="muted">{{status}}</p>
        </div>
    </div>
</body>
</rml>
