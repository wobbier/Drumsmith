/* The practice page: the library's list / details / footer layout with lesson rows. */
.library-page .lesson-row { display: block; width: 100%; margin-bottom: 6dp; padding: 14dp 18dp; text-align: left; font-size: 24dp; color: #ffffffd8; background-color: #00000012; border-left: 3dp #ffffff00; }
.library-page .lesson-row:hover, .library-page .lesson-row:focus, .library-page .lesson-row.selected { background-color: #ffffff12; border-left-color: #ffffff80; color: #ffffff; }
.library-details .lesson-pattern { margin: 16dp 0 4dp; padding: 10dp 12dp; font-size: 22dp; letter-spacing: 2dp; color: #ffb347; background-color: #00000040; }
.library-details .lesson-key { font-size: 14dp; color: #ffffff90; }
.lesson-lane { display: flex; margin: 2dp 0; padding: 3dp 12dp; background-color: #00000040; }
.lesson-lane .lane-name { display: block; width: 110dp; font-size: 15dp; color: #ffffffb8; }
.lesson-lane .lane-steps { display: block; flex: 1; font-size: 15dp; letter-spacing: 2dp; color: #ffb347; }
.lesson-tempo, .lesson-length { margin: 18dp 0 6dp; }
.lesson-tempo label, .lesson-length label { display: block; margin-bottom: 8dp; font-size: 20dp; color: #ffffff; }
.lesson-tempo label span { color: #ffb347; }
.lesson-tempo input { display: block; width: 100%; margin-bottom: 8dp; }
.library-page .tempo-step { display: inline-block; width: auto; margin: 0 6dp 0 0; padding: 6dp 12dp; font-size: 16dp; background-color: #ffffff14; }
.library-page .tempo-step.selected { color: #101010; background-color: #ffb347; }
/* The lesson ladder (CoreGame/Progression.h): a lesson's row says PASSED or LOCKED, and its details what passing takes. */
.library-page .lesson-row { display: flex; justify-content: space-between; }
.library-page .lesson-row .lesson-state { font-size: 14dp; letter-spacing: 2dp; color: #66ff99; padding-top: 6dp; }
.library-page .lesson-row.locked { color: #ffffff60; }
.library-page .lesson-row.locked .lesson-state { color: #ffffff60; }
.library-details .lesson-progress { margin: 14dp 0 4dp; font-size: 18dp; color: #ffd166; }
.library-details .lesson-progress.passed { color: #66ff99; }
/* The songs that play the lesson (CoreGame/LessonPatterns.h), each a click from playing. */
.lesson-songs { margin-top: 22dp; padding-top: 10dp; border-top: 1dp #ffffff20; }
.lesson-songs h3 { margin: 0 0 8dp; font-size: 18dp; letter-spacing: 1dp; color: #ffffff; }
.lesson-song { display: flex; align-items: center; margin: 3dp 0; padding: 6dp 10dp; background-color: #00000040; }
.lesson-song .song-copy { display: block; flex: 1; }
.lesson-song .song-name { display: block; font-size: 16dp; color: #ffffffe0; }
.lesson-song .song-detail { display: block; font-size: 13dp; color: #ffb347; }
.library-page .lesson-song .song-play { display: block; width: auto; padding: 5dp 12dp; font-size: 14dp; font-weight: bold; color: #101010; background-color: #66ff99; }
.library-page .lesson-song .song-play:hover, .library-page .lesson-song .song-play:focus { background-color: #a6ffc6; }
