<rml>
<head>
    <title>Drumsmith</title>
    <link type="text/rcss" href="Drumsmith.rcss"/>
    <link type="text/rcss" href="Radio.rcss"/>
    <link type="text/rcss" href="MainMenu.rcss"/>
</head>
<body class="main-menu-page" data-model="main_menu" data-class-hideout="hideout > 0" data-class-basement="hideout > 0 && hideout_tier == 0">
    <div class="menu-shade" data-if="hideout == 0 || settings_open"></div>
    <!-- The hideout (Docs/Hideout-and-Progression.md): the room is the menu; a label over each station. -->
    <div id="hideout" data-if="hideout > 0 && !settings_open">
        <div id="hideout-overlay" data-if="debug_overlay_hidden == 0">
        <div id="hideout-header" data-if="hideout_focus < 0">
            <img class="hideout-logo" src="img/2x/Asset 2@2x.png"/>
            <p class="hideout-room">{{hideout_room}}</p>
            <p class="hideout-goal">{{hideout_goal}}</p>
            <button id="band-name-link" class="band-link" data-event-click="band_name_edit">{{band_label}}</button>
        </div>
        <div id="band-name-panel" data-if="band_naming > 0">
            <h2>Name the band</h2>
            <p>It goes on the bedsheet and the kick drum. You can change it later.</p>
            <input id="band-name-input" type="text" maxlength="28" placeholder="BAND NAME TBD" data-value="band_name_input"/>
            <div class="band-name-buttons">
                <button id="band-name-save" class="band-button save" data-event-click="band_name_save">PAINT IT</button>
                <button id="band-name-cancel" class="band-button" data-event-click="band_name_cancel">Never mind</button>
            </div>
        </div>
        <div data-for="station : stations">
            <button class="station-label" data-if="station.shown > 0" data-style-left="station.left" data-style-top="station.top" data-style-transform="station.tilt" data-event-click="station(station.index)" data-event-mouseover="station_hover(station.index)" data-event-mouseout="station_hover(-1)" data-event-focus="station_hover(station.index)" data-event-blur="station_hover(-1)"><span class="station-name">{{station.label}}</span><span class="station-hint">{{station.hint}}</span></button>
        </div>
        <div id="hideout-focus" data-if="hideout_focus >= 0">
            <h1>{{hideout_title}}</h1>
            <p>{{hideout_hint}}</p>
            <div id="hideout-records" class="hideout-panel" data-if="hideout_panel == 'records'">
                <div class="record-row" data-for="record : records"><span>{{record.name}}</span><span>{{record.value}}</span></div>
            </div>
            <div id="hideout-wishlist" class="hideout-panel" data-if="hideout_panel == 'wishlist'">
                <div class="wish-row" data-for="wish : wishes" data-class-got="wish.got > 0">
                    <div class="wish-title"><span class="wish-box">{{wish.got > 0 ? 'X' : ''}}</span><span class="wish-name">{{wish.name}}</span></div>
                    <p class="wish-how" data-if="wish.how != ''">{{wish.how}}</p>
                    <p class="wish-description">{{wish.description}}</p>
                </div>
            </div>
            <div id="hideout-gigs" class="hideout-panel" data-if="hideout_panel == 'gigs'">
                <div class="gig-card" data-for="gig : gigs" data-class-locked="gig.state == 'LOCKED'">
                    <div class="gig-title"><span>{{gig.name}}</span><span class="gig-state" data-if="gig.state != ''">{{gig.state}}</span></div>
                    <p>{{gig.description}}</p>
                    <p class="gig-detail">{{gig.detail}}</p>
                    <p class="gig-songs" data-if="gig.songs != ''">{{gig.songs}}</p>
                    <button class="gig-play" data-if="gig.open > 0" data-event-click="gig_play(gig.index)">PLAY THE GIG</button>
                </div>
            </div>
            <p class="hideout-status" data-if="hideout_status != ''">{{hideout_status}}</p>
            <button id="hideout-back" class="menu-link blue" data-event-click="hideout_back">&lt; Back<span class="underline"></span></button>
        </div>
        <div id="hideout-corner" data-if="hideout_focus < 0">
            <button id="hideout-vocals" class="corner-link" onclick="load-scene:Assets/Vocals.lvl">Vocal Test</button>
            <button id="hideout-exit" class="corner-link" onclick="quit">Exit</button>
            <button id="hideout-debug-link" class="corner-link" data-if="debug_allowed > 0" data-event-click="debug_toggle">Debug (F2)</button>
        </div>
        <div id="hideout-reveal" data-if="hideout_reveal != ''"><span>{{hideout_reveal}}</span></div>
        <div id="hideout-notice" data-if="hideout_notice != ''">
            <h2>{{hideout_notice_title}}</h2>
            <p>{{hideout_notice}}</p>
            <button id="hideout-notice-ok" class="menu-link green" autofocus data-event-click="dismiss_notice">OK<span class="underline"></span></button>
        </div>
        </div>
        <!-- The debug menu (F2; Hideout/HideoutDebug.cpp): every stage of the journey on the spot. -->
        <div id="hideout-debug" data-if="debug_open > 0">
            <div class="debug-head"><span class="debug-title">HIDEOUT DEBUG</span><button id="debug-close" class="debug-chip" data-event-click="debug_toggle">Close (F2)</button></div>
            <p class="debug-note">These change your profile and save it. The first change copies yours aside; Restore puts it back.</p>
            <button id="debug-restore" class="debug-wide warn" data-if="debug_backup > 0" data-event-click="debug_restore">Restore my own profile</button>
            <h3>Room</h3>
            <div id="debug-rooms" class="debug-row"><button class="debug-chip" data-for="room : debug_rooms" data-class-on="room.on > 0" data-event-click="debug_room(room.index)">{{room.name}}</button></div>
            <div class="debug-row">
                <button id="debug-move-in" class="debug-chip" data-event-click="debug_move_in">Move in again</button>
                <button id="debug-intro" class="debug-chip" data-event-click="debug_intro">The way in</button>
                <button id="debug-tour" class="debug-chip" data-event-click="debug_tour">Tour the items</button>
                <button id="debug-reload" class="debug-chip" data-event-click="debug_reload">Reload</button>
            </div>
            <h3>Time <span>{{debug_clock}}</span></h3>
            <div class="debug-row">
                <button id="debug-time-auto" class="debug-chip" data-class-on="debug_time == 0" data-event-click="debug_time(0)">My clock</button>
                <button id="debug-time-day" class="debug-chip" data-class-on="debug_time == 1" data-event-click="debug_time(1)">Day</button>
                <button id="debug-time-night" class="debug-chip" data-class-on="debug_time == 2" data-event-click="debug_time(2)">Night</button>
            </div>
            <h3>Items <span>in the room or not; turning one on shows it off</span></h3>
            <div class="debug-row">
                <button id="debug-items-all" class="debug-chip" data-event-click="debug_items(1)">All in</button>
                <button id="debug-items-none" class="debug-chip" data-event-click="debug_items(0)">All out</button>
            </div>
            <div id="debug-items" class="debug-grid"><button class="debug-toggle" data-for="item : debug_items" data-class-on="item.on > 0" data-event-click="debug_item(item.index)">{{item.name}}</button></div>
            <h3>Gigs played</h3>
            <div id="debug-gigs" class="debug-grid"><button class="debug-toggle" data-for="gig : debug_gigs" data-class-on="gig.on > 0" data-event-click="debug_gig(gig.index)">{{gig.name}}</button></div>
            <h3>Lessons passed</h3>
            <div id="debug-steps" class="debug-grid"><button class="debug-toggle" data-for="step : debug_steps" data-class-on="step.on > 0" data-event-click="debug_step(step.index)">{{step.name}} <span>{{step.count}}</span></button></div>
            <button id="debug-evaluate" class="debug-wide" data-event-click="debug_evaluate">Apply the rules: move up, give rewards</button>
            <h3>Band and view</h3>
            <div class="debug-row">
                <button id="debug-name" class="debug-chip" data-event-click="debug_name">Next band name</button>
                <button id="debug-overlay" class="debug-chip" data-event-click="debug_overlay">{{debug_overlay_hidden > 0 ? 'Show the menu' : 'Hide the menu'}}</button>
            </div>
            <button id="debug-reset" class="debug-wide warn" data-event-click="debug_reset">Start over as a new player</button>
            <p id="debug-status" class="debug-status">{{debug_status}}</p>
        </div>
    </div>
    <div id="main-menu" data-if="!settings_open && hideout == 0">
        <img class="brand-logo" src="img/2x/Asset 2@2x.png"/>
        <img class="brand-underline" src="img/Underline.png"/>
        <div class="main-menu-items">
            <button id="play" class="menu-link blue" autofocus onclick="load-scene:Assets/TrackList.lvl">PLAY<span class="underline"></span></button>
            <button id="practice" class="menu-link green" onclick="load-scene:Assets/Practice.lvl">PRACTICE<span class="underline"></span></button>
            <button id="dlc" class="menu-link pink" onclick="load-scene:Assets/DLC.lvl">DLC<span class="underline"></span></button>
            <button id="vocals" class="menu-link pink" onclick="load-scene:Assets/Vocals.lvl">Vocal Test<span class="underline"></span></button>
            <button id="settings" class="menu-link orange" data-event-click="open_settings">SETTINGS<span class="underline"></span></button>
            <button id="exit" class="menu-link red" onclick="quit">EXIT<span class="underline"></span></button>
        </div>
    </div>
    <div id="settings-menu" data-if="settings_open">
        <button id="settings-back" class="menu-link blue" data-event-click="close_settings">&lt; Back<span class="underline"></span></button>
        <h1>SETTINGS</h1>
        <div id="settings-tabs">
            <button id="tab-game" class="settings-tab" data-class-selected="settings_tab == 0" data-event-click="settings_tab(0)">Game</button>
            <button id="tab-sound" class="settings-tab" data-class-selected="settings_tab == 1" data-event-click="settings_tab(1)">Sound &amp; Timing</button>
            <button id="tab-venue" class="settings-tab" data-class-selected="settings_tab == 2" data-event-click="settings_tab(2)">Venue</button>
            <button id="tab-graphics" class="settings-tab" data-class-selected="settings_tab == 5" data-event-click="settings_tab(5)">Graphics</button>
            <button id="tab-kit" class="settings-tab" data-class-selected="settings_tab == 3" data-event-click="settings_tab(3)">Drum Kit</button>
            <button id="tab-songs" class="settings-tab" data-class-selected="settings_tab == 4" data-event-click="settings_tab(4)">Songs</button>
        </div>
        <div class="settings-page" data-if="settings_tab == 0">
            <div class="setting-row">
                <label>Highway Speed <span>{{highway_speed}}%</span></label>
                <input id="highway-speed" type="range" min="50" max="200" step="5" data-value="highway_speed"/>
            </div>
            <div class="setting-row">
                <label>Technique <span>open/closed hi-hat, rimshots, bells</span></label>
                <button id="technique-off" class="device-choice" data-class-selected="technique == 0" data-event-click="technique(0)">Off: any stroke on the right drum counts</button>
                <button id="technique-lenient" class="device-choice" data-class-selected="technique == 1" data-event-click="technique(1)">Lenient: wrong stroke is one grade lower</button>
                <button id="technique-strict" class="device-choice" data-class-selected="technique == 2" data-event-click="technique(2)">Strict: wrong stroke is a miss</button>
            </div>
            <div class="setting-row">
                <label>Lyrics <span>karaoke lines, where the chart has them</span></label>
                <button id="lyrics-both" class="device-choice" data-class-selected="lyrics == 3" data-event-click="lyrics(3)">Both</button>
                <button id="lyrics-hud" class="device-choice" data-class-selected="lyrics == 1" data-event-click="lyrics(1)">HUD</button>
                <button id="lyrics-venue" class="device-choice" data-class-selected="lyrics == 2" data-event-click="lyrics(2)">Venue</button>
                <button id="lyrics-off" class="device-choice" data-class-selected="lyrics == 0" data-event-click="lyrics(0)">Off</button>
            </div>
        </div>
        <div class="settings-page" data-if="settings_tab == 1">
            <div class="setting-row">
                <label>Radio Volume <span>{{radio_volume}}%</span></label>
                <input id="radio-volume" type="range" min="0" max="100" step="1" data-value="radio_volume"/>
            </div>
            <div class="setting-row">
                <label>Metronome <span>a click on every beat, over the song</span></label>
                <button id="metronome-off" class="device-choice" data-class-selected="metronome == 0" data-event-click="metronome(0)">Off</button>
                <button id="metronome-on" class="device-choice" data-class-selected="metronome == 1" data-event-click="metronome(1)">On</button>
            </div>
            <div class="setting-row">
                <label>Audio Delay <span>{{audio_delay}} ms</span></label>
                <input id="audio-delay" type="range" min="0" max="250" step="1" data-value="audio_delay"/>
            </div>
            <div class="setting-row">
                <label>Visual Delay <span>{{video_delay}} ms</span></label>
                <input id="video-delay" type="range" min="0" max="250" step="1" data-value="video_delay"/>
            </div>
            <div class="setting-row">
                <label>Calibration</label>
                <p>Finds both delays for you, in about half a minute on the note highway: first hit as each note crosses the line, in silence, then hit on every click with nothing to watch. Use the kit and the screen and speakers you play with.</p>
                <button id="calibrate" class="small-action" data-event-click="calibrate">Calibrate audio and video</button>
            </div>
        </div>
        <div class="settings-page" data-if="settings_tab == 2">
            <div class="setting-row">
                <label>Stage Lights <span>the light show from the chart</span></label>
                <button id="lighting-full" class="device-choice" data-class-selected="stage_lighting == 2" data-event-click="stage_lighting(2)">Full show</button>
                <button id="lighting-gentle" class="device-choice" data-class-selected="stage_lighting == 1" data-event-click="stage_lighting(1)">No strobes or flashes</button>
                <button id="lighting-off" class="device-choice" data-class-selected="stage_lighting == 0" data-event-click="stage_lighting(0)">Off</button>
            </div>
            <div class="setting-row">
                <label>Venue <span>the stage, band and crowd under the highway</span></label>
                <button id="venue-full" class="device-choice" data-class-selected="venue == 2" data-event-click="venue(2)">Band and crowd</button>
                <button id="venue-band" class="device-choice" data-class-selected="venue == 1" data-event-click="venue(1)">Band only</button>
                <button id="venue-off" class="device-choice" data-class-selected="venue == 0" data-event-click="venue(0)">Off</button>
            </div>
            <div class="setting-row">
                <label>Room <span>where the band plays (F7 swaps it mid-song)</span></label>
                <button id="venue-style-arena" class="device-choice" data-class-selected="venue_id == '' && venue_style == 0" data-event-click="venue_style(0)">Arena<span class="venue-lock" data-if="venue_locked_arena > 0"> (locked: play its gig first)</span></button>
                <button id="venue-style-club" class="device-choice" data-class-selected="venue_id == '' && venue_style == 1" data-event-click="venue_style(1)">Club<span class="venue-lock" data-if="venue_locked_club > 0"> (locked: play its gig first)</span></button>
                <button id="venue-style-festival" class="device-choice" data-class-selected="venue_id == '' && venue_style == 2" data-event-click="venue_style(2)">Festival<span class="venue-lock" data-if="venue_locked_festival > 0"> (locked: play its gig first)</span></button>
                <button id="venue-style-random" class="device-choice" data-class-selected="venue_id == '' && venue_style == 3" data-event-click="venue_style(3)">Random</button>
                <button class="device-choice" data-for="place : venues" data-class-selected="venue_id == place.id" data-event-click="venue_pick(place.id)">{{place.name}}<span class="venue-lock" data-if="place.locked > 0"> (locked)</span></button>
            </div>
            <div class="setting-row">
                <label>Song Venues <span>let a song bring its own venue</span></label>
                <button id="song-venues-on" class="device-choice" data-class-selected="song_venues == 1" data-event-click="song_venues(1)">On</button>
                <button id="song-venues-off" class="device-choice" data-class-selected="song_venues == 0" data-event-click="song_venues(0)">Off</button>
            </div>
            <div class="setting-row">
                <label>Venue Camera <span>whose camera cuts to follow</span></label>
                <button id="venue-camera-live" class="device-choice" data-class-selected="venue_camera == 0" data-event-click="venue_camera(0)">Live show</button>
                <button id="venue-camera-mv" class="device-choice" data-class-selected="venue_camera == 1" data-event-click="venue_camera(1)">Music video</button>
            </div>
        </div>
        <div class="settings-page" data-if="settings_tab == 3">
            <div class="setting-row">
                <label>Select a MIDI Device</label>
                <button class="device-choice" data-for="device : devices" data-class-selected="midi_device == device.name" data-event-click="select_device(device.name)">{{device.name}}</button>
                <p data-if="devices.size == 0">No devices available</p>
                <p class="selected-device">Selected device: {{midi_device == '' ? 'None' : midi_device}}</p>
                <p class="selected-device">{{midi_open == '' ? 'No device connected. Plug one in and it appears here.' : 'Connected: ' + midi_open}}</p>
                <button class="small-action" data-event-click="refresh_devices">Refresh devices</button>
            </div>
            <div class="setting-row">
                <label>Drum Kit <span>the key and the MIDI note that play each pad</span></label>
                <p>Press a pad's Key or MIDI button, then press the key or hit the pad. Esc cancels.</p>
                <div class="kit-row" data-for="pad : pads">
                    <span class="kit-name">{{pad.name}}</span>
                    <button class="kit-bind key" data-class-armed="pad.binding == 1" data-event-click="bind_key(pad.id)">{{pad.key}}</button>
                    <button class="kit-bind midi" data-class-armed="pad.binding == 2" data-event-click="bind_midi(pad.id)">{{pad.midi}}</button>
                    <button class="kit-clear" data-event-click="kit_clear(pad.id)">Clear</button>
                    <span class="kit-extra">{{pad.extra}}</span>
                </div>
                <p>Last hit: {{kit_last}}</p>
                <button id="kit-standard" class="small-action" data-event-click="kit_standard">Use the standard e-kit MIDI notes</button>
            </div>
        </div>
        <div class="settings-page" data-if="settings_tab == 4">
            <div class="setting-row">
                <label>DLC Servers <span>where Download Songs gets its catalogue</span></label>
                <div class="server-row" data-for="server : servers">
                    <span class="server-url">{{server.url}}</span>
                    <span class="server-status" data-class-ok="server.state == 2" data-class-bad="server.state == 3">{{server.status}}</span>
                    <button class="kit-clear server-test" data-event-click="server_test(server.index)">Test</button>
                    <button class="kit-clear server-remove" data-event-click="server_remove(server.index)">Remove</button>
                </div>
                <p data-if="servers.size == 0">No servers yet. Add one below.</p>
                <input id="dlc-server" type="text" placeholder="dlc.example.com" data-value="dlc_url"/>
                <button id="server-add" class="small-action" data-event-click="server_add">Add and test this server</button>
                <p>A server is a host name or a URL; https is assumed without one. Adding it checks that it has a Drumsmith catalogue.</p>
            </div>
            <div class="setting-row">
                <label>Custom Songs <span>Rock Band and Clone Hero folders in Assets/DLC</span></label>
                <button id="convert-dlc" class="small-action pink" data-event-click="convert_dlc">Convert Custom DLC</button>
            </div>
        </div>
        <div class="settings-page" data-if="settings_tab == 5">
            <p class="settings-note">Graphics settings apply and save as you change them.</p>
            <div class="setting-row">
                <label>Quality <span>shadows, lighting and effects</span></label>
                <div class="choice-row">
                    <button id="quality-auto" class="device-choice" onclick="setting:Graphics.Quality|&quot;&quot;" data-setting-selected="Graphics.Quality|&quot;&quot;">Auto</button>
                    <div class="choice-row" data-options="quality"></div>
                </div>
            </div>
            <div class="setting-row">
                <label>Display <span>Alt+Enter also switches</span></label>
                <div class="choice-row">
                    <button id="window-windowed" class="device-choice" onclick="window-mode:windowed" data-window-mode="windowed">Windowed</button>
                    <button id="window-borderless" class="device-choice" onclick="window-mode:borderless" data-window-mode="borderless">Borderless</button>
                    <button id="window-fullscreen" class="device-choice" onclick="window-mode:fullscreen" data-window-mode="fullscreen">Fullscreen</button>
                </div>
            </div>
            <div class="setting-row">
                <label>VSync <span>off lets frames through sooner, with tearing</span></label>
                <div class="choice-row">
                    <button id="vsync-on" class="device-choice" onclick="setting:Graphics.VSync|true" data-setting-selected="Graphics.VSync|true">On</button>
                    <button id="vsync-off" class="device-choice" onclick="setting:Graphics.VSync|false" data-setting-selected="Graphics.VSync|false">Off</button>
                </div>
            </div>
            <div class="setting-row">
                <label>Frame Rate Limit <span>frames a second</span></label>
                <div class="choice-row">
                    <button id="max-fps-0" class="device-choice" onclick="setting:Graphics.MaxFrameRate|0" data-setting-selected="Graphics.MaxFrameRate|0">None</button>
                    <button id="max-fps-60" class="device-choice" onclick="setting:Graphics.MaxFrameRate|60" data-setting-selected="Graphics.MaxFrameRate|60">60</button>
                    <button id="max-fps-120" class="device-choice" onclick="setting:Graphics.MaxFrameRate|120" data-setting-selected="Graphics.MaxFrameRate|120">120</button>
                    <button id="max-fps-144" class="device-choice" onclick="setting:Graphics.MaxFrameRate|144" data-setting-selected="Graphics.MaxFrameRate|144">144</button>
                    <button id="max-fps-240" class="device-choice" onclick="setting:Graphics.MaxFrameRate|240" data-setting-selected="Graphics.MaxFrameRate|240">240</button>
                </div>
            </div>
            <div class="setting-row">
                <label>Render Scale <span id="render-scale-value" data-setting-text="Graphics.RenderScale" data-format="percent"></span></label>
                <div class="choice-row">
                    <button id="render-scale-down" class="device-choice" onclick="setting-step:Graphics.RenderScale|-0.1">Lower</button>
                    <button id="render-scale-up" class="device-choice" onclick="setting-step:Graphics.RenderScale|0.1">Higher</button>
                </div>
            </div>
            <div class="setting-row">
                <label>Upscaling <span>how a lower render scale is stretched to the screen</span></label>
                <div class="choice-row">
                    <button id="upscale-default" class="device-choice" onclick="setting:Graphics.Upscale|&quot;&quot;" data-setting-selected="Graphics.Upscale|&quot;&quot;">Default</button>
                    <button id="upscale-smooth" class="device-choice" onclick="setting:Graphics.Upscale|Bilinear" data-setting-selected="Graphics.Upscale|Bilinear">Smooth</button>
                    <button id="upscale-sharp" class="device-choice" onclick="setting:Graphics.Upscale|Sharp" data-setting-selected="Graphics.Upscale|Sharp">Sharp</button>
                </div>
            </div>
            <div class="setting-row">
                <label>Dynamic Resolution <span>lowers the render scale when frames run long</span></label>
                <div class="choice-row">
                    <button id="dynamic-resolution-on" class="device-choice" onclick="setting:Graphics.DynamicResolution|true" data-setting-selected="Graphics.DynamicResolution|true">On</button>
                    <button id="dynamic-resolution-off" class="device-choice" onclick="setting:Graphics.DynamicResolution|false" data-setting-selected="Graphics.DynamicResolution|false">Off</button>
                </div>
            </div>
        </div>
        <button id="save-settings" class="menu-link green" data-event-click="save_settings">Save Settings<span class="underline"></span></button>
        <p id="settings-status">{{settings_status}}</p>
    </div>
    <div id="track-radio-hover" data-event-mouseover="radio_show"></div>
    <div id="track-radio" data-if="radio_available" data-class-visible="radio_visible" data-event-mouseover="radio_show">
        <img class="radio-art" data-attr-src="radio_art"/>
        <div class="radio-details">
            <div class="radio-caption">NOW PLAYING</div>
            <div id="radio-title">{{radio_title}}</div>
            <div id="radio-artist">{{radio_artist}}</div>
            <div class="radio-controls">
                <div class="radio-progress">
                    <input id="radio-seek" type="range" min="0" max="1000" step="1" data-attr-value="radio_progress" data-event-change="seek(ev.value)"/>
                    <div class="radio-times"><span>{{radio_position}}</span><span>{{radio_duration}}</span></div>
                </div>
                <button id="radio-play" data-event-click="radio_play">Play</button>
                <button id="radio-skip" data-event-click="skip">Skip</button>
            </div>
        </div>
    </div>
</body>
</rml>
