<rml>
<head>
    <title>Drumsmith — Song Library</title>
    <link type="text/rcss" href="Drumsmith.rcss"/>
    <link type="text/rcss" href="Library.rcss"/>
</head>
<body class="library-page song-library" data-model="song_library">
    <div class="library-backdrop"></div>
    <div class="library-header">
        <button id="library-back" class="library-link" onclick="load-scene:Assets/MainMenu.lvl"><img src="img/Esc_Key_Light.png"/><span>Main Menu</span></button>
        <span class="library-heading">SONG LIBRARY</span>
        <button id="library-dlc" class="library-link" onclick="load-scene:Assets/DLC.lvl"><span>Download songs</span></button>
    </div>
    <div class="library-search">
        <input id="song-search" class="text" type="text" placeholder="Search title, artist, album..." data-value="search"/>
        <button id="search-clear" class="library-link" data-if="search != ''" data-event-click="clear_search"><span>Clear</span></button>
        <button id="favorites-only" class="library-link" data-class-active="favorites_only" data-event-click="favorites_only"><span>&#x2605; Favorites ({{favorite_count}})</span></button>
    </div>
    <div id="song-list" class="library-list with-search">
        <p class="empty-library" data-if="track_count == 0">No songs match. Clear the search, choose All songs, turn off Favorites or download more DLC.</p>
        <div data-for="track : tracks">
            <h2 class="track-category" data-if="track.category != ''">{{track.category}}</h2>
            <div class="song-row" data-class-selected="selected == track.index" data-event-mouseover="select(track.index)">
                <button class="row-play" data-event-click="play(track.index)" data-event-focus="select(track.index)">
                    <img class="song-art" data-attr-src="track.art"/>
                    <span class="row-text">
                        <span class="song-title">{{track.title}}</span>
                        <span class="song-artist">{{track.artist}}</span>
                    </span>
                    <span class="row-meta">
                        <span class="badge source" data-if="track.badge != ''">{{track.badge}}</span>
                        <span class="song-year">{{track.year}}</span>
                        <span class="song-notes">{{track.notes}} notes</span>
                    </span>
                    <span class="row-go">PLAY</span>
                </button>
                <button class="favorite-toggle" data-class-on="track.favorite" data-event-click="favorite(track.index)" data-event-focus="select(track.index)"><span data-if="track.favorite">&#x2605;</span><span data-if="!track.favorite">&#x2606;</span></button>
            </div>
        </div>
    </div>
    <div class="library-details" data-if="selected >= 0">
        <img class="detail-art" data-attr-src="detail_art"/>
        <div class="detail-copy">
            <h1>{{detail_title}}</h1>
            <h2>{{detail_artist}}</h2>
            <p class="detail-meta">{{detail_album}}</p>
            <p class="detail-meta"><span>{{detail_genre}}</span><span class="detail-sep" data-if="detail_genre != ''"> / </span><span>{{detail_year}}</span></p>
            <p class="detail-meta">{{detail_notes}} notes</p>
            <p class="detail-best" data-if="detail_best != ''">{{detail_best}}</p>
            <p class="detail-badges"><span class="badge source" data-if="detail_badge != ''">{{detail_badge}}</span><span class="badge ds-ready" data-if="detail_ds_ready">DS READY</span></p>
            <button id="play-selected" class="detail-play" data-event-click="play(selected)">PLAY</button>
            <div class="detail-chips">
                <button class="chip" data-event-click="preview(selected)">Preview</button>
                <button class="chip" data-class-on="detail_favorite" data-event-click="favorite(selected)"><span data-if="detail_favorite">&#x2605; Favorited</span><span data-if="!detail_favorite">&#x2606; Favorite</span></button>
                <button class="chip" data-event-click="stats">Stats</button>
                <button id="edit-selected" class="chip" data-if="tools" data-event-click="edit">Edit chart (F4)</button>
            </div>
            <div class="detail-advice">
                <p data-for="line : advice">{{line.text}}</p>
            </div>
            <p class="listen-caption">Hear the original on</p>
            <div class="listen-links">
                <button class="listen-link" data-event-click="listen(0)">Spotify</button>
                <button class="listen-link" data-event-click="listen(1)">Apple Music</button>
                <button class="listen-link" data-event-click="listen(2)">YouTube Music</button>
            </div>
            <button id="remove-selected" class="detail-remove" data-if="!detail_confirm_remove" data-event-click="remove">Remove from library</button>
            <p class="detail-state" data-if="detail_confirm_remove">Remove this song? Its folder is deleted from this computer.</p>
            <button id="remove-confirm" class="detail-action red" data-if="detail_confirm_remove" data-event-click="remove_confirm">Yes, remove it</button>
            <button id="remove-cancel" class="detail-action" data-if="detail_confirm_remove" data-event-click="remove_cancel">Keep it</button>
        </div>
    </div>
    <div class="library-footer">
        <button id="library-filters" class="library-link" data-event-click="toggle_filters"><span>Sorting: {{sort_name}} (Ascending) / Filter: {{filter_name}}</span><span data-if="favorites_only"> / Favorites only</span></button>
        <span>{{track_count}} songs</span>
    </div>
    <div class="filter-scrim" data-if="filters_open" data-event-click="toggle_filters"></div>
    <div class="library-flyout" data-if="filters_open">
        <button class="detail-action" data-event-click="toggle_filters">&lt; Back</button>
        <h1>Sort</h1>
        <button id="sort-default" data-class-active="sort == 0" data-event-click="sort(0)">Default</button>
        <button id="sort-title" data-class-active="sort == 1" data-event-click="sort(1)">Title</button>
        <button id="sort-artist" data-class-active="sort == 2" data-event-click="sort(2)">Artist</button>
        <button id="sort-year" data-class-active="sort == 3" data-event-click="sort(3)">Year</button>
        <h1>Filter</h1>
        <button id="filter-favorites" data-class-active="favorites_only" data-event-click="favorites_only">&#x2605; Favorites only ({{favorite_count}})</button>
        <button data-for="option : filters" data-class-active="filter == option.index" data-event-click="filter(option.index)">{{option.name}} ({{option.count}})</button>
    </div>
</body>
</rml>
