body.main-menu-page {
    decorator: image(img/drums-bg.png cover);
    overflow: hidden;
}
#main-menu {
    position: absolute;
    left: 4vw;
    top: 5vh;
    width: 602dp;
    max-width: 65vw;
    height: 90vh;
    overflow-y: auto;
}
.brand-logo { display: block; width: 602dp; max-width: 100%; }
.brand-underline { display: block; width: 602dp; max-width: 100%; height: 10dp; margin-top: 15dp; margin-bottom: 16dp; }
/* A column of links each as wide as its text, so the underline matches the word like the old page. */
.main-menu-items { display: flex; flex-direction: column; align-items: flex-start; }
.main-menu-items .menu-link { display: block; width: auto; margin: 12dp 0 0; padding: 0 0 4dp; font-size: 48dp; text-align: left; }
#settings-menu {
    position: absolute;
    left: 4vw;
    top: 4vh;
    bottom: 4vh;
    width: 700dp;
    max-width: 80vw;
    padding: 24dp;
    overflow-y: auto;
    background-color: #101010e8;
}
#settings-menu h1 { font-size: 24dp; color: #cccccc; margin: 18dp 0 20dp; }
#settings-menu .menu-link { width: auto; margin: 10dp 0; padding: 0 0 4dp; font-size: 32dp; text-align: left; }
.setting-row { margin-bottom: 22dp; }
.setting-row label { display: block; margin-bottom: 12dp; font-size: 26dp; }
.setting-row label span { color: #c5c5c5; font-size: 20dp; }
.setting-row p { margin: 8dp 0; font-size: 17dp; color: #d8d8d8; }
.setting-row input[type=text] { box-sizing: border-box; width: 100%; height: 42dp; padding: 9dp 12dp; color: #ffffff; font-size: 18dp; background-color: #ffffff18; border: 1dp #888888; tab-index: auto; }
.setting-row input[type=text]:focus { border-color: #ff9933; }
#settings-menu .device-choice { display: block; width: 100%; margin: 4dp 0; padding: 9dp 12dp; text-align: left; font-size: 18dp; border: 1dp #ffffff30; background-color: #ffffff08; }
#settings-menu .device-choice.selected { border-color: #66ff66; background-color: #66ff6618; }
/* Graphics: short choices side by side. The quality presets are generated by the engine (class "choice"). */
#settings-menu .choice-row { display: flex; flex-wrap: wrap; }
#settings-menu .choice-row .device-choice, #settings-menu .choice-row .choice { display: block; width: auto; margin: 4dp 8dp 4dp 0; padding: 9dp 16dp; text-align: center; font-size: 18dp; border: 1dp #ffffff30; background-color: #ffffff08; }
#settings-menu .choice-row .device-choice.selected, #settings-menu .choice-row .choice.selected { border-color: #66ff66; background-color: #66ff6618; }
#settings-menu .settings-note { margin: 0 0 16dp; font-size: 17dp; color: #c5c5c5; }
#settings-tabs { display: flex; margin: 0 0 22dp; border-bottom: 1dp #ffffff30; }
#settings-menu .settings-tab { display: block; width: auto; margin: 0 4dp 0 0; padding: 9dp 13dp; font-size: 19dp; color: #c5c5c5; border-bottom: 3dp #ffffff00; }
#settings-menu .settings-tab:hover, #settings-menu .settings-tab:focus { color: #ffffff; }
#settings-menu .settings-tab.selected { color: #ffffff; border-bottom-color: #ff9933; }
.server-row { display: flex; align-items: center; margin: 3dp 0; padding: 4dp 0 4dp 12dp; border: 1dp #ffffff30; background-color: #ffffff08; }
.server-row .server-url { display: block; flex: 1; font-size: 18dp; }
.server-row .server-status { display: block; margin: 0 12dp; font-size: 15dp; color: #c5c5c5; }
.server-row .server-status.ok { color: #77cc77; }
.server-row .server-status.bad { color: #e36363; }
.kit-row { display: flex; align-items: center; margin: 3dp 0; }
.kit-row .kit-name { display: block; width: 150dp; font-size: 18dp; }
#settings-menu .kit-bind { display: block; width: 160dp; margin: 0 8dp 0 0; padding: 7dp 10dp; text-align: left; font-size: 17dp; border: 1dp #ffffff30; background-color: #ffffff08; }
#settings-menu .kit-bind.armed { border-color: #ff9933; background-color: #ff993328; color: #ffffff; }
.kit-row .kit-extra { display: block; flex: 1; margin-left: 8dp; font-size: 15dp; color: #a8a8a8; }
#settings-menu .kit-clear { display: block; width: auto; padding: 7dp 10dp; font-size: 15dp; color: #c5c5c5; }
#settings-menu .small-action { display: inline-block; width: auto; margin: 4dp 8dp 4dp 0; padding: 4dp 0; font-size: 18dp; }
#settings-status { min-height: 24dp; margin: 8dp 0; color: #66ff66; font-size: 16dp; }
.main-menu-page input[type=range] { display: block; width: 100%; height: 24dp; tab-index: auto; nav: auto; }
.main-menu-page input[type=range] slidertrack { height: 5dp; margin: 10dp 0; background-color: #ffffff60; }
.main-menu-page input[type=range] sliderbar { width: 14dp; height: 24dp; margin-top: -10dp; background-color: #eeeeee; }
.main-menu-page input[type=range]:focus sliderbar, .main-menu-page input[type=range] sliderbar:hover { background-color: #ff9933; }
.main-menu-page input[type=range] sliderarrowdec, .main-menu-page input[type=range] sliderarrowinc { display: none; }
@media (max-height: 800px) {
    .main-menu-items .menu-link { font-size: 38dp; margin: 8dp 0 0; }
    .brand-logo { width: 500dp; }
    .brand-underline { width: 500dp; margin-bottom: 12dp; }
}
@media (max-width: 1000px) {
    #main-menu { max-width: 80vw; }
    #settings-menu { max-width: 75vw; }
}

/* The hideout: the room behind the menu (Hideout/Hideout.h). */
body.main-menu-page.hideout { decorator: none; }
#hideout { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
#hideout-header { position: absolute; left: 3vw; top: 4vh; width: 520dp; max-width: 60vw; padding: 16dp 20dp; background-color: #0000008c; }
#hideout-header .hideout-logo { display: block; width: 300dp; max-width: 100%; }
#hideout-header .hideout-room { margin: 10dp 0 2dp; font-size: 30dp; color: #ffffff; }
#hideout-header .hideout-goal { margin: 4dp 0 0; font-size: 18dp; color: #ffd166; }
.station-label { position: absolute; display: block; width: 240dp; margin-left: -120dp; margin-top: -70dp; padding: 6dp 8dp; text-align: center; background-color: #000000a0; border-bottom: 3dp #ff9933; }
.station-label:hover, .station-label:focus { background-color: #ff9933d0; }
.station-label .station-name { display: block; font-size: 26dp; font-weight: bold; color: #ffffff; }
.station-label .station-hint { display: block; font-size: 14dp; color: #ffffffb0; }
#hideout-focus { position: absolute; left: 3vw; top: 4vh; bottom: 4vh; width: 560dp; max-width: 70vw; padding: 20dp 24dp; overflow-y: auto; background-color: #000000b8; }
#hideout-focus h1 { font-size: 40dp; margin: 0 0 4dp; }
#hideout-focus p { font-size: 18dp; color: #dddddd; margin: 4dp 0 12dp; }
#hideout-focus .menu-link { width: auto; margin-top: 16dp; font-size: 32dp; text-align: left; }
.hideout-panel { margin-top: 10dp; }
.record-row { display: flex; justify-content: space-between; padding: 6dp 0; font-size: 20dp; border-bottom: 1dp #ffffff20; }
.gig-card { margin-bottom: 14dp; padding: 12dp 14dp; background-color: #ffffff10; border-left: 3dp #ff9933; }
.gig-card.locked { border-left-color: #ffffff40; color: #ffffff80; }
.gig-card .gig-title { display: flex; justify-content: space-between; font-size: 24dp; font-weight: bold; }
.gig-card .gig-state { font-size: 14dp; letter-spacing: 2dp; color: #66ff99; padding-top: 6dp; }
.gig-card.locked .gig-state { color: #ffffff70; }
#hideout-focus .gig-card p { margin: 4dp 0; font-size: 16dp; }
#hideout-focus .gig-card .gig-detail { color: #ffd166; }
#hideout-focus .gig-card .gig-songs { color: #ffffffa8; }
.gig-card .gig-play { display: block; margin-top: 8dp; padding: 8dp 12dp; font-size: 20dp; font-weight: bold; text-align: center; color: #000000; background-color: #66ff99; }
.gig-card .gig-play:hover, .gig-card .gig-play:focus { background-color: #a6ffc6; }
#hideout-focus .hideout-status { color: #ff6666; }
#hideout-corner { position: absolute; left: 3vw; bottom: 3vh; }
#hideout-corner .corner-link { display: inline-block; margin-right: 18dp; padding: 6dp 12dp; font-size: 18dp; color: #ffffffc0; background-color: #00000080; }
#hideout-corner .corner-link:hover, #hideout-corner .corner-link:focus { color: #ffffff; background-color: #ff9933c0; }
#hideout-notice { position: absolute; left: 50%; top: 22vh; width: 560dp; margin-left: -280dp; padding: 24dp 28dp; text-align: center; background-color: #101010f0; border-top: 4dp #ffd166; }
#hideout-notice h2 { font-size: 28dp; margin: 0 0 12dp; color: #ffd166; }
#hideout-notice p { font-size: 20dp; white-space: pre-line; color: #ffffff; }
#hideout-notice .menu-link { width: auto; margin: 16dp auto 0; font-size: 32dp; }
#settings-menu .device-choice .venue-lock { color: #ffffff70; font-size: 15dp; }

/* The basement (tier 0): masking-tape labels in marker, the header on a scrap of cardboard, the
   notice a sticky note. Later rooms keep the sleek defaults above. */
body.basement .station-label { width: 210dp; margin-left: -105dp; padding: 8dp 10dp 6dp; background-color: #e9dfbfec; border-bottom: 2dp #b9a77e; }
body.basement .station-label:hover, body.basement .station-label:focus { background-color: #fff3a8; }
body.basement .station-label .station-name { color: #231c16; font-size: 25dp; letter-spacing: 1dp; }
body.basement .station-label .station-hint { color: #5d5144; font-size: 13dp; }
body.basement #hideout-header { background-color: #6e5236ee; border: 2dp #4b3621; transform: rotate(-1deg); }
body.basement #hideout-header .hideout-goal { color: #ffe08a; }
body.basement #hideout-notice { background-color: #f5e27aee; border-top: 0; transform: rotate(1.2deg); color: #2a2218; }
body.basement #hideout-notice h2 { color: #9b2c1c; }
body.basement #hideout-notice p { color: #2a2218; }
body.basement #hideout-notice .menu-link { color: #2a2218; }
body.basement #hideout-focus { background-color: #160f0ae0; border-right: 3dp #6e5236; }
body.basement #hideout-corner .corner-link { background-color: #e9dfbfd0; color: #231c16; }
body.basement #hideout-corner .corner-link:hover, body.basement #hideout-corner .corner-link:focus { background-color: #fff3a8; }
/* The new items' tour: what the camera is showing. */
#hideout-reveal { position: absolute; left: 50%; top: 26vh; width: 520dp; margin-left: -260dp; padding: 14dp 18dp; text-align: center; background-color: #101010e6; border-bottom: 3dp #ffd166; }
#hideout-reveal span { font-size: 30dp; font-weight: bold; color: #ffd166; }
body.basement #hideout-reveal { background-color: #f5e27aee; border-bottom: 0; transform: rotate(-1.5deg); }
body.basement #hideout-reveal span { color: #2a2218; }
