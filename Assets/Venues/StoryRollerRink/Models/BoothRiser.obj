# The drummer's little riser in the booth (glitter edge in the palette).
mtllib BoothRiser.mtl
o BoothRiser
s off
v 1.8 0 -1.7
v 1.8 0.3 -1.7
v 1.8 0.3 1.7
v 1.8 0 1.7
v -1.8 0.3 1.7
v -1.8 0.3 -1.7
v -1.8 0 -1.7
v -1.8 0 1.7
vt 0.093750 0.906250
vt 0.093750 0.968750
vt 0.031250 0.906250
vn 1 0 0
vn -1 0 -0
vn 0 1 0
vn 0 -1 0
vn 0 0 -1
vn 0 -0 1
usemtl violet
f 1/1/1 2/1/1 3/1/1 4/1/1
f 5/1/2 6/1/2 7/1/2 8/1/2
usemtl black
f 3/2/3 2/2/3 6/2/3 5/2/3
f 7/2/4 1/2/4 4/2/4 8/2/4
f 6/2/5 2/2/5 1/2/5 7/2/5
usemtl purple_glow1_5
f 4/3/6 3/3/6 5/3/6 8/3/6
