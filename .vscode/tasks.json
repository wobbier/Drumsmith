{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-havana-editor-debug",
      "type": "shell",
      "command": "make",
      "args": [
        "-f",
        "Drumsmith.make",
        "Havana",
        "config=editor_debug",
        "-j$(nproc)"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build-havana-game-debug",
      "type": "shell",
      "command": "make",
      "args": [
        "-f",
        "Drumsmith.make",
        "Game_EntryPoint",
        "config=game_linux_debug",
        "-j$(nproc)"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
